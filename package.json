{
  "name": "inkmark",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run web#dev",
    "dev:backend": "vp run @inkmark/backend#dev",
    "dev:mobile": "vp run mobile#dev",
    "build": "vp run web#build",
    "typecheck": "vp run -r typecheck",
    "test": "vp run -r test",
    "lint": "vp lint --deny-warnings",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "ready": "vp run format:check && vp run lint && vp run -r typecheck && vp run -r test && vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.18.0"
}
