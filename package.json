{
  "name": "inkmark",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "convex": "^1.50.0",
      "typescript": "^7.0.2",
      "vite": "8.3.7"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun --filter web dev",
    "dev:backend": "bun --filter @inkmark/backend dev",
    "dev:mobile": "bun --filter mobile dev",
    "build": "bun --filter web build",
    "lint": "bunx bun@1.4.5-canary.20261121.1 lint --no-script --type-aware --max-warnings=0",
    "lint:fix": "bunx bun@1.4.5-canary.20261121.1 lint --no-script --type-aware --fix",
    "ready": "bun fmt --check && bun lint && bun check && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.5",
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ]
}
