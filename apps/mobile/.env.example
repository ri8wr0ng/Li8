# The URL of your Convex deployment (same as VITE_CONVEX_URL in packages/backend/.env.local)
EXPO_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Web app origin that serves /mobile-auth.html (the Google sign-in hand-off back to the app).
# Must be an allowed redirect origin on the backend: http://localhost:3000 or SITE_URL.
# A phone can't reach your computer's localhost, so on a device use the deployed SITE_URL.
EXPO_PUBLIC_SITE_URL=http://localhost:3000
